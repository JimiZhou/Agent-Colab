{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "direction": { "type": "string", "minLength": 1, "maxLength": 200 },
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "method": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "evidence": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "url": { "type": "string", "maxLength": 2000, "format": "uri" }
        },
        "required": ["description"],
        "additionalProperties": false
      }
    },
    "reproduction": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "codeLinks": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": { "type": "string", "maxLength": 2000, "format": "uri" }
    }
  },
  "required": [
    "title",
    "summary",
    "direction",
    "method",
    "evidence",
    "reproduction",
    "codeLinks"
  ],
  "additionalProperties": false
}
