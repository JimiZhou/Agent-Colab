{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "mode": {
      "default": "owner",
      "type": "string",
      "enum": ["owner", "community"]
    },
    "public": { "default": false, "type": "boolean" },
    "summary": { "default": "", "type": "string", "maxLength": 8000 },
    "stage": {
      "default": "Exploration",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "threshold": {
      "default": 2,
      "type": "integer",
      "minimum": 2,
      "maximum": 20
    }
  },
  "required": [
    "name",
    "goal",
    "mode",
    "public",
    "summary",
    "stage",
    "threshold"
  ],
  "additionalProperties": false
}
