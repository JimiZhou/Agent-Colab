{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "maxLength": 2000,
      "format": "uri"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "pr": {
      "type": "string",
      "maxLength": 2000,
      "format": "uri"
    }
  },
  "required": ["url"],
  "additionalProperties": false
}
