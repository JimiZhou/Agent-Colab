{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findingId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "vote": {
      "type": "string",
      "enum": ["approve", "reject", "revoke"]
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "notes": {
      "default": "",
      "type": "string",
      "maxLength": 8000
    },
    "failureReason": {
      "default": "",
      "type": "string",
      "maxLength": 8000
    },
    "reproduced": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "findingId",
    "vote",
    "environment",
    "evidence",
    "notes",
    "failureReason",
    "reproduced"
  ],
  "additionalProperties": false
}
